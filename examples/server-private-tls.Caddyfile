{
	bifrost {
		server {
			connector :8443 {
				tls public.example.com
				endpoint home {
					token {$HOME_TOKEN}
					policy replace_existing
					limits {
						max_streams 100
					}
				}
			}

			passthrough :443 {
				route_sni home.example.com home
				route_sni files.example.com home
			}
		}
	}
}
