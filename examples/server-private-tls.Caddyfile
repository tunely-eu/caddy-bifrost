{
	servers :443 {
		listener_wrappers {
			bifrost {
				route_sni home.example.com home
				route_sni files.example.com home
			}
			tls
		}
	}

	bifrost {
		server public.example.com {
			endpoint home {
				token {$HOME_TOKEN}
				policy replace_existing
				limits {
					max_streams 100
				}
			}
		}
	}
}

:443 {
	abort
}
