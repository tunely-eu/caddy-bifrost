{
	bifrost {
		server {
			connector :8443 {
				tls public.example.com
				endpoint home {
					token {$HOME_TOKEN}
					policy replace_existing
					limits {
						max_streams 100
					}
				}
			}
		}
	}
}

home.example.com {
	reverse_proxy http://home {
		transport bifrost {
			endpoint home
		}
	}
}
